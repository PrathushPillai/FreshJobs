# Copy to .env and fill in. Never commit .env.

# How often to check every company's job board (minutes)
POLL_MINUTES=5

# Email alerts. For Gmail: turn on 2-step verification, create an App Password
# at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_FROM=you@gmail.com
ALERT_TO=you@gmail.com

# Adzuna job search API: jobs from thousands of employers. Free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Google for Jobs (LinkedIn, Indeed, Glassdoor postings) via JSearch. Free key (200 requests/month):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  -- then add searches on the Sources page.
JSEARCH_API_KEY=
# Minutes between runs of each saved search (240 fits the free plan with ~1 search; lower on a paid plan)
JSEARCH_MIN_INTERVAL_MINUTES=240

# Hunter.io recruiter email lookup. Free key (25 searches/month) at https://hunter.io/api-keys
HUNTER_API_KEY=

# Chatbot (phase 3)
ANTHROPIC_API_KEY=

# Optional: use Postgres instead of the local SQLite file
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/jobs
