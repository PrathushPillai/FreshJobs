# Copy to .env and fill in. Never commit .env.

# How often to check every company's job board (minutes)
POLL_MINUTES=5

# Email alerts. For Gmail: turn on 2-step verification, create an App Password
# at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_FROM=you@gmail.com
ALERT_TO=you@gmail.com

# Adzuna job search API: jobs from thousands of employers. Free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Google for Jobs (LinkedIn, Indeed, Glassdoor postings) via JSearch. Free key (200 requests/month):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  -- then add searches on the Sources page.
JSEARCH_API_KEY=
# Minutes between runs of each saved search (240 fits the free plan with ~1 search; lower on a paid plan)
JSEARCH_MIN_INTERVAL_MINUTES=240

# Hunter.io recruiter email lookup. Free key (25 searches/month) at https://hunter.io/api-keys
HUNTER_API_KEY=

# Chatbot (phase 3)
ANTHROPIC_API_KEY=

# Where the database lives. Keep it out of OneDrive (syncing a multi-GB file slows every query)
# and out of AppData (the Claude desktop app redirects that folder). Default: backend/jobs.db
# DATABASE_URL=sqlite:///C:/Users/<you>/FreshJobs/jobs.db

# Accounts
# The account with this email is the admin (Sources, Check now) and takes over the data from before accounts.
# Leave empty only on a laptop: then the first account to sign up becomes the admin.
ADMIN_EMAIL=
# Where the site is opened; links in emails (confirm, reset, unsubscribe) point here.
PUBLIC_URL=http://localhost:5173
# true behind HTTPS (the cloud server), so the login cookie is never sent over plain HTTP.
SECURE_COOKIES=false
# Contact & support messages go here (empty = ADMIN_EMAIL)
SUPPORT_EMAIL=
# The automatic API pages (/docs); keep false on the shared server
API_DOCS=false
